{
  "name": "@wasm-gaming/mgba-wasm",
  "version": "0.1.1",
  "description": "mGBA (Game Boy Advance / Game Boy / Game Boy Color emulator) compiled to WebAssembly via Emscripten, with a JS SDK conforming to the wasm-gaming engine contract.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wasm-gaming/mGBA-wasm.git"
  },
  "bugs": {
    "url": "https://github.com/wasm-gaming/mGBA-wasm/issues"
  },
  "homepage": "https://github.com/wasm-gaming/mGBA-wasm#readme",
  "type": "module",
  "main": "./dist/mgba/mgba.sdk.js",
  "types": "./dist/mgba/mgba.sdk.d.ts",
  "exports": {
    ".": {
      "types": "./dist/mgba/mgba.sdk.d.ts",
      "import": "./dist/mgba/mgba.sdk.js"
    },
    "./options": {
      "types": "./dist/mgba/mgba.options.d.ts",
      "import": "./dist/mgba/mgba.options.js"
    },
    "./manifest": "./dist/manifest.json"
  },
  "files": [
    "dist/mgba/",
    "dist/manifest.json",
    "src/mgba.config.ts",
    "src/mgba.manifest.ts",
    "src/mgba.options.ts",
    "src/mgba.sdk.ts",
    "src/mgba.zip.ts",
    "README.md"
  ],
  "comment:scripts": "Build logic lives in the Makefile, not here (make build / build-sdk / build-wasm / preview).",
  "scripts": {},
  "peerDependencies": {
    "@wasm-gaming/engine-specs": ">=0.2.6"
  },
  "peerDependenciesMeta": {
    "@wasm-gaming/engine-specs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@wasm-gaming/engine-specs": "^0.2.6",
    "typescript": "^5.5.0"
  },
  "engineContract": "https://github.com/wasm-gaming/engine-specs",
  "license": "MPL-2.0"
}
